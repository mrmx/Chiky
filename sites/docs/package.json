		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@vitest/coverage-v8": "^3.2.4",
		"npm-run-all2": "^8.0.4",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.40.1",
		"svelte-check": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"vitest": "^3.2.4"
	},
	"pnpm": {}
}
