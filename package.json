{
	"private": true,
	"name": "chiqui-monorepo",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter docs dev",
		"dev:docs": "pnpm --filter docs dev",
		"dev:headless-demo": "pnpm --filter headless-demo dev",
		"build": "pnpm --filter @mrmx/chiqui build && pnpm --filter docs build",
		"test": "pnpm -r test",
		"check": "pnpm -r check",
		"format": "prettier -l --write ."
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild"
		]
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0"
	}
}
