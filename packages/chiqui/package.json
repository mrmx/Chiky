{
	"name": "@mrmx/chiqui",
	"version": "0.2.0",
	"description": "Content-driven SvelteKit SSG framework with i18n, mdsvex content pipeline, and DaisyUI components.",
	"type": "module",
	"license": "MIT",
	"author": "mrmx <mistermx@gmail.com>",
	"homepage": "https://github.com/mrmx/Chiqui#readme",
	"bugs": {
		"url": "https://github.com/mrmx/Chiqui/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mrmx/Chiqui.git",
		"directory": "packages/chiqui"
	},
	"keywords": [
		"sveltekit",
		"svelte",
		"ssg",
		"static-site-generator",
		"mdsvex",
		"i18n",
		"daisyui",
		"tailwindcss"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"svelte": "./dist/components/index.js",
			"default": "./dist/components/index.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"default": "./dist/config.js"
		},
		"./content": {
			"types": "./dist/content.d.ts",
			"default": "./dist/content.js"
		},
		"./navigation": {
			"types": "./dist/navigation.d.ts",
			"default": "./dist/navigation.js"
		},
		"./hooks": {
			"types": "./dist/hooks.d.ts",
			"default": "./dist/hooks.js"
		},
		"./sitemap": {
			"types": "./dist/sitemap.d.ts",
			"default": "./dist/sitemap.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./svelte-config": {
			"types": "./dist/svelte-config.d.ts",
			"default": "./dist/svelte-config.js"
		},
		"./style.css": "./dist/style.css"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "svelte-kit sync && svelte-package && pnpm build:css",
		"build:css": "tailwindcss -i src/style.css -o dist/style.css --minify",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"prepare": "pnpm build",
		"prepublishOnly": "pnpm build"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@iconify/svelte": "^5.0.2",
		"mdsvex": "^0.12.6"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.47.0",
		"@sveltejs/package": "^2.3.11",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@vitest/coverage-v8": "^3.2.4",
		"daisyui": "^5.5.19",
		"svelte": "^5.40.1",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"vitest": "^3.2.4"
	}
}
